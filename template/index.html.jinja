<!DOCTYPE html>
<html lang="{{ site.lang }}" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ site.title }}</title>
<style>
:root{--bg:#ece8df;--panel:#f8f5ee;--paper:#fffdf8;--ink:#252a28;--muted:#6f6c65;--line:#c9c2b7;--soft:#ddd7cd;--accent:#783a3d;--accent2:#3d5f67;--moss:#536453;--ochre:#a36f2d}
html[data-theme="dark"]{--bg:#101316;--panel:#161a1e;--paper:#1b2025;--ink:#eef1f3;--muted:#a8afb6;--line:#39414a;--soft:#2a3138;--accent:#b76b70;--accent2:#74a0aa;--moss:#829c82;--ochre:#d39a50}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,Arial,sans-serif;min-height:100vh}button,input{font:inherit}.app{display:grid;grid-template-columns:320px minmax(620px,1fr) 330px;grid-template-rows:66px calc(100vh - 66px);min-height:100vh}.brand,.toolbar,.view-tabs{background:var(--paper);border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:12px;padding:0 18px;border-right:1px solid var(--line)}.brand-mark{width:34px;height:34px;border:1px solid var(--ink);border-radius:50%;display:grid;place-items:center;font-family:Georgia,serif;font-weight:700}.brand strong{display:block;font-family:Georgia,serif;font-size:18px}.brand small{display:block;color:var(--muted);letter-spacing:.14em;font-size:10px;margin-top:10px;line-height:1.25}.toolbar{display:flex;align-items:center;padding:0 28px;gap:14px}.search{flex:1;display:flex;align-items:center;gap:10px;border:1px solid var(--line);background:var(--panel);padding:11px 14px}.search input{border:0;outline:0;background:transparent;color:var(--ink);width:100%}.toolbar-actions,.lang-switch{display:flex}.toolbar-actions{gap:8px}.icon-btn,.lang-btn,.tab,.chip{border:1px solid var(--line);background:var(--panel);color:var(--ink);cursor:pointer;padding:9px 11px}.lang-btn{border-right:0}.lang-btn:last-child{border-right:1px solid var(--line)}.lang-btn.active,.tab.active{background:var(--accent);color:#fff;border-color:var(--accent)}.view-tabs{display:flex;align-items:center;justify-content:flex-end;padding:0 16px;gap:8px}.profile{grid-row:2;background:var(--panel);border-right:1px solid var(--line);padding:24px 18px;overflow:auto}.avatar{display:block;margin:0 auto;width:116px;height:116px;border-radius:50%;border:1px solid var(--ink);object-fit:cover;background:var(--paper)}.profile h1{font-family:Georgia,serif;font-size:31px;line-height:.95;margin:18px 0 6px}.login{font-size:20px;color:var(--muted);margin-bottom:15px}.bio{font-size:15px;line-height:1.45;margin-bottom:18px}.stats{display:flex;gap:8px;flex-wrap:wrap;color:var(--muted);font-size:14px;margin:14px 0 18px}.stats strong{color:var(--ink)}.meta{display:grid;gap:10px;font-size:14px}.meta-row{display:grid;grid-template-columns:22px minmax(0,1fr);gap:9px;align-items:start}.meta a{color:var(--ink);text-decoration:none;overflow-wrap:anywhere}.subjects{margin-top:24px;border-top:1px solid var(--line);padding-top:18px}.eyebrow{font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);font-weight:700}.subject{display:flex;justify-content:space-between;padding:11px 0;border-bottom:1px solid var(--soft);font-family:Georgia,serif;cursor:pointer}.graph-wrap{grid-row:2;position:relative;background-color:var(--paper);background-image:linear-gradient(var(--soft) 1px,transparent 1px),linear-gradient(90deg,var(--soft) 1px,transparent 1px);background-size:32px 32px;overflow:hidden;min-width:0}.graph-head{position:absolute;z-index:3;left:24px;top:18px}.graph-head h2{font-family:Georgia,serif;margin:0;font-size:22px}.graph-head p{margin:3px 0;color:var(--muted);font-size:12px}.legend{position:absolute;right:24px;top:20px;display:flex;gap:12px;flex-wrap:wrap;color:var(--muted);font-size:11px;z-index:3}.dot{width:8px;height:8px;border-radius:50%;display:inline-block;margin-right:4px}.graph{position:absolute;inset:0}.edge{position:absolute;height:1px;background:var(--line);transform-origin:left center;z-index:1}.node{position:absolute;transform:translate(-50%,-50%);background:var(--paper);border:1px solid var(--line);min-width:145px;padding:14px;text-align:center;cursor:pointer;box-shadow:0 4px 10px rgba(0,0,0,.05);z-index:2}.node.active{border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 18%,transparent)}.node::before{content:"";position:absolute;left:-1px;right:-1px;top:-1px;height:4px;background:var(--accent2)}.node.project::before{background:var(--accent)}.node.org::before{background:var(--moss)}.node.practice::before{background:var(--ochre)}.node small{display:block;letter-spacing:.13em;text-transform:uppercase;color:var(--muted);font-size:9px;font-weight:700}.node strong{display:block;font-family:Georgia,serif;font-size:16px;margin:7px 0 4px}.node span{font-size:10px;color:var(--muted)}.root{width:170px;height:170px;border-radius:50%;display:grid;place-items:center;padding:20px}.root::before{display:none}.root img{width:66px;height:66px;border-radius:50%;object-fit:cover;border:1px solid var(--ink)}.root strong{font-size:18px;margin:6px 0 0}.status{position:absolute;left:24px;bottom:18px;color:var(--muted);font-size:10px;letter-spacing:.08em;text-transform:uppercase}.context{grid-row:2;background:var(--panel);border-left:1px solid var(--line);display:grid;grid-template-rows:1fr auto;overflow:auto}.context-main{padding:25px 20px}.context h2{font-family:Georgia,serif;font-size:28px;margin:7px 0 8px}.context p{font-family:Georgia,serif;color:var(--muted);line-height:1.5}.facts{margin-top:20px}.fact{display:flex;justify-content:space-between;gap:20px;border-bottom:1px solid var(--line);padding:10px 0;font-size:12px}.fact strong{text-align:right}.chips{display:flex;flex-wrap:wrap;gap:7px;margin-top:10px}.chip{font-size:11px;background:var(--paper)}.llm{padding:20px;background:color-mix(in srgb,var(--ochre) 9%,var(--panel));border-top:1px solid var(--line)}.llm h3{font-family:Georgia,serif;font-size:22px;margin:8px 0}.prompt{font-family:monospace;font-size:10px;line-height:1.35;border:1px solid var(--line);background:var(--paper);padding:12px;height:74px;overflow:hidden;color:var(--muted)}.copy{width:100%;margin-top:10px;padding:12px;border:0;background:var(--accent);color:#fff;font-weight:700;letter-spacing:.07em;cursor:pointer}
@media(max-width:1280px){.app{grid-template-columns:280px minmax(540px,1fr);grid-template-rows:66px minmax(650px,calc(100vh - 66px)) auto}.view-tabs{display:none}.context{grid-column:1/-1;grid-row:3;display:grid;grid-template-columns:minmax(0,1fr) minmax(320px,420px);grid-template-rows:auto;border-left:0;border-top:1px solid var(--line);overflow:visible}.context-main{min-height:300px}.llm{border-top:0;border-left:1px solid var(--line)}.profile{grid-row:2}.graph-wrap{grid-row:2;min-height:650px}}
@media(max-width:820px){.app{display:grid;grid-template-columns:1fr;grid-template-rows:auto auto auto minmax(620px,72vh) auto}.brand{grid-row:1;padding:12px 16px;border-right:0}.toolbar{grid-row:2;padding:10px 12px;flex-wrap:wrap}.search{order:2;flex-basis:100%}.toolbar-actions{margin-left:auto}.profile{grid-row:3;border-right:0;border-bottom:1px solid var(--line);padding:18px;display:grid;grid-template-columns:92px minmax(0,1fr);column-gap:16px;overflow:visible}.avatar{width:92px;height:92px;grid-row:1/4}.profile h1{font-size:27px;margin:4px 0 4px}.login{font-size:16px;margin-bottom:8px}.bio,.stats,.meta,.subjects{grid-column:1/-1}.bio{margin-top:16px}.meta{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.subjects{margin-top:18px}.graph-wrap{grid-row:4;min-height:620px;overflow:auto;overscroll-behavior:contain}.graph{min-width:900px;min-height:620px}.graph-head{position:sticky;left:16px;top:14px;width:max-content}.legend{display:none}.status{display:none}.context{grid-column:1;grid-row:5;display:block}.context-main,.llm{padding:20px}.llm{border-left:0;border-top:1px solid var(--line)}}
@media(max-width:520px){.brand small{font-size:8px}.toolbar-actions{width:100%;justify-content:space-between}.lang-btn,.icon-btn{padding:8px 10px}.profile{grid-template-columns:76px minmax(0,1fr);padding:16px}.avatar{width:76px;height:76px}.profile h1{font-size:24px}.login{font-size:15px}.bio{font-size:14px}.meta{grid-template-columns:1fr}.graph-wrap{min-height:560px}.graph{min-width:820px;min-height:560px}.node{min-width:128px;padding:11px}.root{width:150px;height:150px}.context h2{font-size:24px}}
</style>
</head>
<body>
<div class="app">
<header class="brand"><div class="brand-mark">{{ brand.mark }}</div><div><strong data-i18n="archive">{{ translations.pt.archive }}</strong><small data-i18n="archiveSub">{{ translations.pt.archiveSub }}</small></div></header>
<div class="toolbar"><label class="search">⌕<input id="search" data-i18n-placeholder="search" placeholder="{{ translations.pt.search }}"></label><div class="toolbar-actions"><div class="lang-switch"><button class="lang-btn active" data-lang="pt">PT</button><button class="lang-btn" data-lang="en">EN</button><button class="lang-btn" data-lang="es">ES</button></div><button class="icon-btn" id="themeToggle">◐</button></div></div>
<nav class="view-tabs"><button class="tab active" data-i18n="graph">{{ translations.pt.graph }}</button><button class="tab" data-i18n="timeline">{{ translations.pt.timeline }}</button><button class="tab" data-i18n="index">{{ translations.pt.index }}</button></nav>
<aside class="profile"><img class="avatar" src="{{ profile.avatar }}" alt="{{ profile.name }}"><h1>{{ profile.name_lines | inline_markup }}</h1><div class="login">{{ profile.login | inline_markup }}</div><div class="bio">{{ profile.bio | inline_markup }}</div><div class="stats"><span>◉ <strong>{{ profile.followers }}</strong> <span data-i18n="followers">{{ translations.pt.followers }}</span></span><span>·</span><span><strong>{{ profile.following }}</strong> <span data-i18n="following">{{ translations.pt.following }}</span></span></div><div class="meta"><div class="meta-row"><span>▦</span><span>{{ profile.company | inline_markup }}</span></div><div class="meta-row"><span>⌖</span><span data-i18n="country">{{ translations.pt.country }}</span></div><div class="meta-row"><span>◷</span><span id="clock">--:-- (UTC -03:00)</span></div><div class="meta-row"><span>✉</span><a href="mailto:{{ profile.email }}">{{ profile.email }}</a></div><div class="meta-row"><span>↗</span><a href="{{ profile.website.url }}" target="_blank">{{ profile.website.label }}</a></div><div class="meta-row"><span>in</span><a href="{{ profile.linkedin.url }}" target="_blank">{{ profile.linkedin.label }}</a></div><div class="meta-row"><span>↗</span><a href="{{ profile.infobim.url }}" target="_blank">{{ profile.infobim.label }}</a></div><div class="meta-row"><span>⌘</span><a href="{{ profile.github.url }}" target="_blank">{{ profile.github.label }}</a></div></div><div class="subjects"><div class="eyebrow" data-i18n="explore">{{ translations.pt.explore }}</div><div id="subjectList"></div></div></aside>
<main class="graph-wrap"><div class="graph-head"><h2 data-i18n="knowledgeGraph">{{ translations.pt.knowledgeGraph }}</h2><p data-i18n="graphHelp">{{ translations.pt.graphHelp }}</p></div><div class="legend"><span><i class="dot" style="background:var(--accent2)"></i><span data-i18n="domain">{{ translations.pt.domain }}</span></span><span><i class="dot" style="background:var(--accent)"></i><span data-i18n="project">{{ translations.pt.project }}</span></span><span><i class="dot" style="background:var(--moss)"></i><span data-i18n="organization">{{ translations.pt.organization }}</span></span><span><i class="dot" style="background:var(--ochre)"></i><span data-i18n="practice">{{ translations.pt.practice }}</span></span></div><div class="graph" id="graph"></div><div class="status" data-i18n="projection">{{ translations.pt.projection }}</div></main>
<aside class="context"><div class="context-main"><div class="eyebrow" id="contextType"></div><h2 id="contextTitle"></h2><p id="contextDescription"></p><div class="facts" id="facts"></div><div class="eyebrow" style="margin-top:22px" data-i18n="connected">{{ translations.pt.connected }}</div><div class="chips" id="chips"></div></div><section class="llm"><div class="eyebrow" data-i18n="portable">{{ translations.pt.portable }}</div><h3 data-i18n="askLlm">{{ translations.pt.askLlm }}</h3><p data-i18n="llmDesc">{{ translations.pt.llmDesc }}</p><div class="prompt" id="promptPreview"></div><button class="copy" id="copyPrompt" data-i18n="copy">{{ translations.pt.copy }}</button></section></aside>
</div>
<script>
const nodes={{ nodes | tojson }};
const links={{ links | tojson }};
const i18n={{ translations | tojson }};
let lang=localStorage.getItem('elias-lang')||'pt',selected='ontobdc';const graph=document.getElementById('graph');
function renderGraph(){graph.innerHTML='';const r=graph.getBoundingClientRect();links.forEach(([a,b])=>{const n1=nodes.find(n=>n.id===a),n2=nodes.find(n=>n.id===b),x1=r.width*n1.x/100,y1=r.height*n1.y/100,x2=r.width*n2.x/100,y2=r.height*n2.y/100,dx=x2-x1,dy=y2-y1,e=document.createElement('div');e.className='edge';e.style.left=x1+'px';e.style.top=y1+'px';e.style.width=Math.hypot(dx,dy)+'px';e.style.transform=`rotate(${Math.atan2(dy,dx)}rad)`;graph.appendChild(e)});nodes.forEach(n=>{const el=document.createElement('button');el.className='node '+(n.type==='person'?'root':n.type)+(n.id===selected?' active':'');el.style.left=n.x+'%';el.style.top=n.y+'%';el.innerHTML=n.type==='person'?`<img src="{{ profile.avatar }}" alt=""><strong>${n.label}</strong><small>${i18n[lang].type_person}</small>`:`<small>${i18n[lang]['type_'+n.type]}</small><strong>${n.label}</strong><span>${links.filter(l=>l.includes(n.id)).length} ${i18n[lang].connections.toLowerCase()}</span>`;el.onclick=()=>selectNode(n.id);graph.appendChild(el)})}
function selectNode(id){selected=id;renderGraph();renderContext();if(innerWidth<=820)document.querySelector('.context').scrollIntoView({behavior:'smooth',block:'start'})}
function renderContext(){const n=nodes.find(x=>x.id===selected),connected=links.filter(l=>l.includes(selected)).map(l=>l[0]===selected?l[1]:l[0]).map(id=>nodes.find(n=>n.id===id));contextType.textContent=i18n[lang]['type_'+n.type];contextTitle.textContent=n.label;contextDescription.innerHTML=n.desc_html[lang];facts.innerHTML=`<div class="fact"><span>${i18n[lang].kind}</span><strong>${i18n[lang]['type_'+n.type]}</strong></div><div class="fact"><span>${i18n[lang].connections}</span><strong>${connected.length}</strong></div>`;chips.innerHTML=connected.map(n=>`<button class="chip" data-id="${n.id}">${n.label}</button>`).join('');document.querySelectorAll('.chip').forEach(b=>b.onclick=()=>selectNode(b.dataset.id));promptPreview.textContent=buildPrompt().slice(0,260)+'…'}
function buildPrompt(){const kb={'@context':{'@vocab':'https://elias.eng.br/ns/'},'@graph':nodes.map(n=>({'@id':n.id,'@type':n.type,name:n.label,description:n.desc[lang],connectedTo:links.filter(l=>l.includes(n.id)).map(l=>l[0]===n.id?l[1]:l[0])}))};return `Use only the following public knowledge base to answer factual questions about Elias Magalhães. Do not invent missing information. Distinguish explicit facts from inference. Current context: ${nodes.find(n=>n.id===selected).label}.\n\n${JSON.stringify(kb,null,2)}`}
function renderSubjects(){subjectList.innerHTML=nodes.filter(n=>n.type!=='person').map(n=>`<div class="subject" data-id="${n.id}"><span>${n.label}</span><small>${links.filter(l=>l.includes(n.id)).length}</small></div>`).join('');document.querySelectorAll('.subject').forEach(s=>s.onclick=()=>selectNode(s.dataset.id))}
function applyLang(next){lang=next;localStorage.setItem('elias-lang',lang);document.documentElement.lang=lang==='pt'?'pt-BR':lang;document.querySelectorAll('[data-i18n]').forEach(el=>el.textContent=i18n[lang][el.dataset.i18n]);document.querySelectorAll('[data-i18n-placeholder]').forEach(el=>el.placeholder=i18n[lang][el.dataset.i18nPlaceholder]);document.querySelectorAll('.lang-btn').forEach(b=>b.classList.toggle('active',b.dataset.lang===lang));renderGraph();renderContext();clock()}
function applyTheme(theme){document.documentElement.dataset.theme=theme;localStorage.setItem('elias-theme',theme)}
function clock(){document.getElementById('clock').textContent=new Intl.DateTimeFormat(lang==='pt'?'pt-BR':lang==='es'?'es-ES':'en-US',{timeZone:'America/Sao_Paulo',hour:'2-digit',minute:'2-digit',hour12:false}).format(new Date())+' (UTC -03:00)'}
themeToggle.onclick=()=>applyTheme(document.documentElement.dataset.theme==='dark'?'light':'dark');document.querySelectorAll('.lang-btn').forEach(b=>b.onclick=()=>applyLang(b.dataset.lang));copyPrompt.onclick=async()=>{try{await navigator.clipboard.writeText(buildPrompt())}catch{const t=document.createElement('textarea');t.value=buildPrompt();document.body.appendChild(t);t.select();document.execCommand('copy');t.remove()}const old=copyPrompt.textContent;copyPrompt.textContent=i18n[lang].copied;setTimeout(()=>copyPrompt.textContent=old,1400)};search.addEventListener('input',e=>{const q=e.target.value.toLowerCase().trim();if(!q)return;const n=nodes.find(n=>n.label.toLowerCase().includes(q)||n.desc[lang].toLowerCase().includes(q));if(n)selectNode(n.id)});applyTheme(localStorage.getItem('elias-theme')||'light');renderSubjects();applyLang(lang);setInterval(clock,30000);addEventListener('resize',()=>requestAnimationFrame(renderGraph));
</script>
</body>
</html>
